# Copy to .env.production outside version control and replace every CHANGE_ME value.
APP_ENV=production
DEBUG=false
DOCS_ENABLED=false
DATABASE_URL=postgresql+asyncpg://gigveyro:CHANGE_ME@postgres:5432/gigveyro
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TOTP_ENCRYPTION_KEY=CHANGE_ME_VALID_FERNET_KEY
OWNER_2FA_REQUIRED=true
CORS_ALLOWED_ORIGINS=["https://app.example.com"]
ALLOWED_HOSTS=["app.example.com"]
DEPOSIT_PROVIDER_TYPE=trongrid
TRONGRID_API_KEY=
REALTIME_BROKER=redis
WEB_CONCURRENCY=2
RATE_LIMIT_FAIL_MODE=closed
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PAYOUT_ENABLED=false
PAYOUT_PROVIDER_MODE=disabled
PAYOUT_SIMULATION_ENABLED=false
BYBIT_PRIVATE_ENABLED=false
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_WRITE_ENABLED=false
BYBIT_WRITE_API_KEY=
BYBIT_WRITE_API_SECRET=
BYBIT_WRITE_PERMISSION_VERIFIED=false
BYBIT_WRITE_IP_WHITELIST_VERIFIED=false
BYBIT_LIVE_RECONCILIATION_VERIFIED=false
SENTRY_DSN=
