# Copy to .env.production outside version control and replace every CHANGE_ME value.
APP_ENV=production
DEBUG=false
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_BOT_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TELEGRAM_WEBHOOK_BASE_URL=https://app.example.com
TELEGRAM_WEB_APP_URL=https://app.example.com
DOCS_ENABLED=false
DATABASE_URL=postgresql+asyncpg://gigveyro:CHANGE_ME@postgres:5432/gigveyro
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TOTP_ENCRYPTION_KEY=CHANGE_ME_VALID_FERNET_KEY
OWNER_2FA_REQUIRED=true
CORS_ALLOWED_ORIGINS=["https://app.example.com"]
# Must include BOTH the public domain (for browser/nginx traffic, where
# nginx sets Host to the real hostname) AND "backend" (the Docker Compose
# service name the frontend's server-side BFF calls use as Host when it
# talks to the backend directly via http://backend:8000, bypassing nginx -
# confirmed via a live Docker run: without "backend" here, EVERY BFF call
# to the backend - login, session refresh, every /api/backend/* proxy
# request - fails with "Invalid host header" and the site is unusable,
# while every healthcheck still reports green. "backend" is safe to allow
# because that container has no published host port; only other
# containers on the private compose network can ever present it as Host.
ALLOWED_HOSTS=["app.example.com","backend"]
DEPOSIT_PROVIDER_TYPE=trongrid
TRONGRID_API_KEY=
TRONGRID_MAX_RETRIES=2
TRONGRID_PAGE_SIZE=100
TRONGRID_MAX_PAGES=10
TRONGRID_SCAN_OVERLAP_SECONDS=300
REALTIME_BROKER=redis
WEB_CONCURRENCY=2
RATE_LIMIT_FAIL_MODE=closed
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PAYOUT_ENABLED=false
PAYOUT_PROVIDER_MODE=disabled
PAYOUT_SIMULATION_ENABLED=false
BYBIT_PRIVATE_ENABLED=false
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_WRITE_ENABLED=false
BYBIT_WRITE_API_KEY=
BYBIT_WRITE_API_SECRET=
BYBIT_WRITE_PERMISSION_VERIFIED=false
BYBIT_WRITE_IP_WHITELIST_VERIFIED=false
BYBIT_LIVE_RECONCILIATION_VERIFIED=false
SENTRY_DSN=
