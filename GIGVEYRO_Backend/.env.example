# ============================================================
# GIGVEYRO Backend — Environment Variables Example
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME=GIGVEYRO
APP_ENV=development
# Set to 'production' to enable production validation rules.
# DEBUG must be false in production.
DEBUG=true
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_BOT_MODE=polling
TELEGRAM_WEB_APP_URL=http://localhost:3000
DOCS_ENABLED=true

# ── Database ──────────────────────────────────────────────────
# Replace CHANGE_ME with your real password.
DATABASE_URL=postgresql+asyncpg://gigveyro_user:CHANGE_ME@localhost:5432/gigveyro

# Production pool settings (tunable)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Authentication (JWT) ──────────────────────────────────────
# MUST be at least 32 characters in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis ─────────────────────────────────────────────────────
# Used for: rate limiting (distributed), ARQ worker queue, optional WebSocket pub/sub
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# ── Background Workers (ARQ) ──────────────────────────────────
WORKER_CONCURRENCY=4
OUTBOX_BATCH_SIZE=50
SCAN_INTERVAL_SECONDS=60

# ── Security & CORS ───────────────────────────────────────────
# Comma-separated list. No wildcards in production.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ── Rate Limiting ─────────────────────────────────────────────
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
DEFAULT_RATE_LIMIT_REQUESTS=100
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60

# ── Deal & Deposit Settings ───────────────────────────────────
DEAL_TTL_MINUTES=30
# Dev/demo rate only — NOT a real exchange rate source
DEMO_USDT_TJS_RATE=10.90
DEPOSIT_TTL_MINUTES=30
TRC20_REQUIRED_CONFIRMATIONS=20

# ── Provider Selection ────────────────────────────────────────
# DEPOSIT_PROVIDER_TYPE: "mock" (dev) | "trongrid" (production)
DEPOSIT_PROVIDER_TYPE=mock

# "business" is the production path; configured/fallback are development-only legacy modes.
EXCHANGE_RATE_PROVIDER_TYPE=business

# PAYOUT_PROVIDER_TYPE: "mock" (dev) | "external_adapter" (production)
PAYOUT_PROVIDER_TYPE=mock

# ── CRITICAL: Payout Safety ───────────────────────────────────
# KEEP FALSE until external payout gateway is verified and secured.
# Setting to true enables real fund transfers via ExternalPayoutAdapter.
PAYOUT_ENABLED=false

# Allow mock providers in production (set true for staging environments)
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# ── TronGrid (USDT TRC20 Read-Only Scanner) ───────────────────
TRONGRID_API_URL=https://api.trongrid.io
# Get your API key at: https://www.trongrid.io/
TRONGRID_API_KEY=
TRON_SCANNER_TIMEOUT_SECONDS=10.0
TRONGRID_MAX_RETRIES=2
TRONGRID_PAGE_SIZE=100
TRONGRID_MAX_PAGES=10
# Every successful scan persists a timestamp watermark in Redis and re-reads
# this overlap window. Database provider-event uniqueness makes overlap safe.
TRONGRID_SCAN_OVERLAP_SECONDS=300

# USDT TRC20 contract (mainnet). Do NOT change unless testing on testnet.
USDT_TRC20_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_TRC20_DECIMALS=6
# The platform's deposit address. MUST be a real TRC20 address in production.
# Dev placeholder — replace before going live.
USDT_TRC20_DEPOSIT_ADDRESS=TMOCK_GIGVEYRO_DEPOSIT_ADDRESS

# ── Exchange Rate API ─────────────────────────────────────────
EXCHANGE_RATE_API_URL=https://api.binance.com/api/v3/ticker/price?symbol=USDTUAH
EXCHANGE_RATE_TIMEOUT_SECONDS=5.0
EXCHANGE_RATE_MAX_RETRIES=3
EXCHANGE_RATE_CACHE_TTL_SECONDS=60

# Public market observation only. These endpoints require no API keys and are
# never used as the TJS/USDT Deal rate source.
BINANCE_PUBLIC_BASE_URL=https://data-api.binance.vision
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com
MARKET_DATA_PRIMARY=binance
MARKET_DATA_SECONDARY=bybit
MARKET_DATA_SYMBOLS=["BTCUSDT","ETHUSDT","USDCUSDT"]
MARKET_DATA_CACHE_TTL_SECONDS=10
MARKET_DATA_TIMEOUT_SECONDS=5.0
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_MAX_CONCURRENCY=4
MARKET_MAX_DEVIATION_BPS=100
MARKET_CIRCUIT_FAILURE_THRESHOLD=3
MARKET_CIRCUIT_COOLDOWN_SECONDS=30

# Bybit private API observation. Keep disabled until a read-only key is configured.
BYBIT_PRIVATE_ENABLED=false
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_RECV_WINDOW_MS=5000
BYBIT_PRIVATE_TIMEOUT_SECONDS=8.0
BYBIT_PRIVATE_MAX_RETRIES=2

# Future live payout credential plane. It is intentionally separate from the
# read-only treasury key above and cannot be enabled in the current build.
PAYOUT_PROVIDER_MODE=disabled
BYBIT_WRITE_ENABLED=false
BYBIT_WRITE_API_KEY=
BYBIT_WRITE_API_SECRET=
BYBIT_WRITE_PERMISSION_VERIFIED=false
BYBIT_WRITE_IP_WHITELIST_VERIFIED=false
BYBIT_LIVE_RECONCILIATION_VERIFIED=false
BYBIT_WITHDRAW_METADATA_MAX_AGE_SECONDS=60

# Authoritative fiat rate. NBT is an official daily reference, not a cash/P2P rate.
NBT_FIAT_BASE_URL=https://nbt.tj/en/kurs/export_xml.php
# Indicative comparison source only by default; its open terms require attribution.
EXCHANGE_RATE_API_BASE_URL=https://open.er-api.com/v6/latest/USD
FIAT_RATE_PRIMARY=nbt
FIAT_RATE_SECONDARY=exchange_rate_api
FIAT_ALLOW_INDICATIVE_FALLBACK=false
FIAT_RATE_CACHE_TTL_SECONDS=21600
FIAT_RATE_MAX_AGE_SECONDS=345600
FIAT_RATE_MAX_DEVIATION_BPS=500
FIAT_RATE_TIMEOUT_SECONDS=8.0
FIAT_RATE_MAX_RETRIES=1
FIAT_RATE_MAX_CONCURRENCY=2
FIAT_RATE_MIN_TJS_PER_USD=5
FIAT_RATE_MAX_TJS_PER_USD=20
# fixed: explicit 1 USDT = USDT_FIXED_USD_RATE USD assumption.
# market: reserved for an approved direct stablecoin/USD reference policy.
USDT_PEG_MODE=fixed
USDT_FIXED_USD_RATE=1.0
BUSINESS_RATE_MARKUP_BPS=0
BUSINESS_RATE_SPREAD_BPS=0
BUSINESS_RATE_POLICY_VERSION=official-fiat-fixed-peg-v1
BUSINESS_RATE_MIN_TJS_PER_USDT=5
BUSINESS_RATE_MAX_TJS_PER_USDT=20
FIAT_CONVERSION_CACHE_TTL_SECONDS=21600
FIAT_CONVERSION_MAX_AGE_SECONDS=345600
FIAT_CONVERSION_MIN_TJS_PER_RUB=0.01
FIAT_CONVERSION_MAX_TJS_PER_RUB=1
FIAT_CONVERSION_MARKUP_BPS=0
FIAT_CONVERSION_FEE_BPS=0
FIAT_CONVERSION_POLICY_VERSION=nbt-official-zero-adjustment-v1

# ── Payout Provider (external_adapter only) ───────────────────
# Required when PAYOUT_PROVIDER_TYPE=external_adapter
PAYOUT_API_URL=https://api.payout-provider.example.com
PAYOUT_API_KEY=

# ── Error Monitoring (Sentry) — Optional ─────────────────────
# Leave empty to disable Sentry. No data sent without DSN.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Metrics may be open in local development. In production either disable them
# or protect the endpoint with a strong, independently generated bearer token.
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=

# ── Realtime / WebSocket ──────────────────────────────────────
REALTIME_TICKET_EXPIRE_SECONDS=30
REALTIME_HEARTBEAT_SECONDS=25.0
REALTIME_OUTBOX_POLL_SECONDS=0.25

# ── Session Cleanup ───────────────────────────────────────────
SESSION_CLEANUP_RETENTION_DAYS=30

# ── Two-Factor Authentication (TOTP, owner-only for now) ──────
# MUST be a real generated Fernet key in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY
# Set true in production once every OWNER account has 2FA configured.
# When enabled, OWNER login requires completing the forced setup flow before
# a full access/refresh session can be issued.
OWNER_2FA_REQUIRED=false
TWO_FACTOR_SETUP_EXPIRE_MINUTES=10
TWO_FACTOR_CHALLENGE_EXPIRE_SECONDS=300
TWO_FACTOR_MAX_CHALLENGE_ATTEMPTS=5
TWO_FACTOR_RECOVERY_CODE_COUNT=10
TWO_FACTOR_VERIFY_RATE_LIMIT_REQUESTS=10
TWO_FACTOR_VERIFY_RATE_LIMIT_WINDOW_SECONDS=300
