# Staging uses isolated infrastructure and never production/customer secrets.
APP_ENV=staging
DEBUG=false
DOCS_ENABLED=false
DATABASE_URL=postgresql+asyncpg://gigveyro_staging:CHANGE_ME@staging-db:5432/gigveyro_staging
REDIS_URL=redis://staging-redis:6379/0
JWT_SECRET_KEY=CHANGE_ME_STAGING_RANDOM_SECRET
TOTP_ENCRYPTION_KEY=CHANGE_ME_STAGING_FERNET_KEY
OWNER_2FA_REQUIRED=true
CORS_ALLOWED_ORIGINS=["https://staging.example.com"]
ALLOWED_HOSTS=["staging.example.com"]
DEPOSIT_PROVIDER_TYPE=mock
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=true
REALTIME_BROKER=redis
RATE_LIMIT_FAIL_MODE=closed
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=CHANGE_ME_STAGING_METRICS_TOKEN
PAYOUT_ENABLED=false
PAYOUT_PROVIDER_MODE=disabled
PAYOUT_SIMULATION_ENABLED=false
BYBIT_PRIVATE_ENABLED=false
BYBIT_WRITE_ENABLED=false
